{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/style2.css",
      "destination": "/style.css",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
